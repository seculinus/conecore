{
  "compilerOptions": {
    "outDir": "./built",
    "allowJs": true,
    "target": "esnext",
    "jsx": "preserve",
    "skipLibCheck": true,
    "moduleResolution":"bundler",
    "strict": true,
    "module": "esnext",
    "strictNullChecks": false,
"paths": {
  "@/*": [
    "./*", "./src/*"
  ],
  "react": [ "./node_modules/@types/react" ]
},

  },
  "include": ["./src/**/*"]
}